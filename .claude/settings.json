{
  "permissions": {
    "allow": [
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo test *)",
      "Bash(cargo fmt *)",
      "Bash(cargo clippy *)",
      "Bash(pnpm install)",
      "Bash(pnpm dev *)",
      "Bash(pnpm build *)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm tauri dev *)",
      "Bash(pnpm tauri build *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(node --version)",
      "Bash(rustc --version)",

      "PowerShell(cargo build *)",
      "PowerShell(cargo check *)",
      "PowerShell(cargo test *)",
      "PowerShell(cargo fmt *)",
      "PowerShell(cargo clippy *)",
      "PowerShell(pnpm install)",
      "PowerShell(pnpm dev *)",
      "PowerShell(pnpm build *)",
      "PowerShell(pnpm test *)",
      "PowerShell(pnpm lint *)",
      "PowerShell(pnpm tauri dev *)",
      "PowerShell(pnpm tauri build *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git branch *)",
      "PowerShell(node --version)",
      "PowerShell(rustc --version)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf .git*)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-delete.mjs",
            "timeout": 10,
            "statusMessage": "削除ガードで確認中..."
          }
        ]
      }
    ]
  }
}
